<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/update_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/update_laden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update herunterladen" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="Danach die heruntergeladene Datei öffnen und „Aktualisieren“ tippen. Einstellungen und Fahrten bleiben erhalten."
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/starten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Jetzt aufzeichnen" />

        <Button
            android:id="@+id/beenden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fahrt beenden" />

        <Switch
            android:id="@+id/automatik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Automatisch aufzeichnen, wenn das Auto verbunden ist" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Fahrten"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/fahrten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Einrichtung"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/einrichtung_kurz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/berechtigungen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Berechtigungen erteilen" />

        <Button
            android:id="@+id/details_knopf"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Details anzeigen" />

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/einrichtung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Auto wählen" />

            <Button
                android:id="@+id/aktualisieren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Etappen aktualisieren" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.7"
                android:text="Etappen-Link: im Urlaubsplaner unter Reisen → Tracking. Dort richtet der Knopf „Tracking einrichten“ ihn von selbst ein."
                android:textSize="13sp" />

            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://…/teilen/widget/…/etappen.json"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <Button
                android:id="@+id/speichern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link speichern" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
