# Kopieren nach .env und mit vim anpassen:  cp .env.example .env && chmod 600 .env && vim .env
# Geheimen Schlüssel erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bitte-aendern
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=urlaub.example.org
BASIS_URL=https://urlaub.example.org
HINTER_PROXY=1
# Hostname des Containers (für den Mailversand)
URLAUB_HOST=urlaub.example.org

POSTGRES_DB=urlaub
POSTGRES_USER=urlaub
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_HOST=db

# E-Mail über msmtp (Konto „urlaub“ in ./msmtprc)
EMAIL_BACKEND=portal.mail_backend.MsmtpBackend
MSMTP_ACCOUNT=urlaub
DEFAULT_FROM_EMAIL=urlaub@example.org

# Betreiber (erscheint im Datenschutzhinweis)
BETREIBER_NAME=
BETREIBER_EMAIL=

# TomTom (developer.tomtom.com → Dashboard → Keys)
# Standardschlüssel für alle Familien ohne eigenen Schlüssel (weitere in der Verwaltung)
TOMTOM_API_KEY=
# Tageskontingent des Standardschlüssels (Freemium: 50.000 Kacheln, 2.500 übrige Abrufe); nur für die Anzeige
#TOMTOM_KONTINGENT_KACHELN=50000
#TOMTOM_KONTINGENT_ANFRAGEN=2500

# Sicherung (betrieb/backup.sh): höchstens so viele Tage in /var/backups/urlaub; optional Kopie in ein weiteres Verzeichnis
BACKUP_TAGE=14
BACKUP_EXTERN=
